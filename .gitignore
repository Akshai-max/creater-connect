# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (DO NOT commit secrets)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite (Postgres is the source of truth)
*.db
*.db-shm
*.db-wal

# creator data exports — never commit real PII
*.csv
seed-creators.csv

# lead engine output (contains contact data — never commit)
/exports/
# fictional test fixtures are safe to commit
!tests/fixtures/*.csv

# filled submission workbook (contains lead data)
/submission/

# researched lead inputs (real creators) — never commit
/data/
