# Copy to .env.local and fill in.   ->   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real keys or connection strings.

# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Shared password to access the dashboard. Anyone with it can sign in.
# Set the same value locally and in your Vercel project. Use a long random string.
APP_PASSWORD=

# Postgres connection string. Easiest path: provision Neon (free) from the
# Vercel Storage tab, which auto-injects DATABASE_URL. Or use any Postgres.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─────────────────────────────────────────────────────────────
# BRAND CONFIG (recommended — makes the AI features yours)
# ─────────────────────────────────────────────────────────────

# Your brand's display name (shown in the UI and used in outreach drafts).
BRAND_NAME=Acme

# The kind of creators you want. Used by the fit scorer + quality filters.
TARGET_NICHE=your product category

# A short paragraph describing your brand, products, positioning, and what
# makes a creator a good fit. Injected verbatim into the AI scoring/outreach
# prompts — the more specific, the better the drafts.
BRAND_CONTEXT=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — features degrade gracefully if these are unset
# ─────────────────────────────────────────────────────────────

# AI candidate scoring + outreach drafting (Claude Haiku 4.5, ~$0.001/call).
# Without it, the app falls back to heuristic scoring and template emails.
# https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=

# Email sending. Without it, pitches save as drafts instead of sending.
# https://resend.com  →  API Keys
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=outreach@example.com

# Apify auto-discovery (daily creator scraping via /api/discover + webhook).
# https://console.apify.com  →  Settings → Integrations
APIFY_TOKEN=
# Shared secret the Apify webhook must send as: Authorization: Bearer <secret>
APIFY_WEBHOOK_SECRET=

# Protects /api/discover from random hits in production (Vercel Cron bypasses it).
# Set to a random string.
CRON_SECRET=
