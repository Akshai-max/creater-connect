# Copy to .env.local and fill in.   ->   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real keys or connection strings.

# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Shared password to access the dashboard. Anyone with it can sign in.
# Set the same value locally and in your Vercel project. Use a long random string.
APP_PASSWORD=

# Postgres connection string. Easiest path: provision Neon (free) from the
# Vercel Storage tab, which auto-injects DATABASE_URL. Or use any Postgres.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─────────────────────────────────────────────────────────────
# BRAND CONFIG (recommended — makes the AI features yours)
# ─────────────────────────────────────────────────────────────

# Your brand's display name (shown in the UI and used in outreach drafts).
BRAND_NAME=Acme

# The kind of creators you want. Used by the fit scorer + quality filters.
TARGET_NICHE=your product category

# A short paragraph describing your brand, products, positioning, and what
# makes a creator a good fit. Injected verbatim into the AI scoring/outreach
# prompts — the more specific, the better the drafts.
BRAND_CONTEXT=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — features degrade gracefully if these are unset
# ─────────────────────────────────────────────────────────────

# AI candidate scoring + outreach drafting (Claude Haiku 4.5, ~$0.001/call).
# Without it, the app falls back to heuristic scoring and template emails.
# https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=

# Email sending. Without it, pitches save as drafts instead of sending.
# https://resend.com  →  API Keys
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=outreach@example.com

# Apify auto-discovery (daily creator scraping via /api/discover + webhook).
# https://console.apify.com  →  Settings → Integrations
APIFY_TOKEN=
# The daily /api/discover cron scrapes Instagram hashtags through Apify. Instagram's
# terms don't allow automated collection, so it is off unless set to "enabled".
APIFY_DISCOVERY=
# Shared secret the Apify webhook must send as: Authorization: Bearer <secret>
APIFY_WEBHOOK_SECRET=

# Protects /api/discover. Vercel Cron sends it automatically as a Bearer token.
# Set to a random string.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# LEAD ENGINE (npm run engine) — see README › Lead engine
# ─────────────────────────────────────────────────────────────

# Sender identity. Required: without it no message can be generated, so no
# lead can qualify (every message must identify the sender).
SENDER_NAME=
SENDER_ROLE=
SENDER_COMPANY=
SENDER_WEBSITE=
# Physical postal address (CAN-SPAM requires one in commercial email).
SENDER_POSTAL_ADDRESS=

# Optional: refresh activity data from the official YouTube Data API v3.
# https://console.cloud.google.com → APIs → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# Optional: check Instagram handles that creators publish, with the official
# Instagram Graph API Business Discovery endpoint. Needs YOUR OWN Instagram
# professional account linked to a Facebook Page, and a Meta app:
# developers.facebook.com → My Apps → Create app → add Instagram Graph API →
# Graph API Explorer (instagram_basic, pages_show_list) → long-lived token.
# IG user id: GET /me/accounts?fields=instagram_business_account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# Shared secret for POST /api/engine/ingest (Authorization: Bearer <secret>).
ENGINE_WEBHOOK_SECRET=

# Number of Priority A leads (default 25).
PRIORITY_A_COUNT=25

# ─────────────────────────────────────────────────────────────
# TEST MODE / SEED TEST — accounts YOU own only
# ─────────────────────────────────────────────────────────────

# "test" (default) refuses to send to anyone not on the allowlist.
OUTREACH_MODE=test
# Comma-separated channel:recipient pairs you own.
# e.g. email:you@yourdomain.com,linkedin:https://www.linkedin.com/in/you,instagram:@your_test_account
SEED_TEST_ALLOWLIST=
# Public base URL used in tracking links (e.g. your Vercel URL).
APP_BASE_URL=http://localhost:3000
# Where tracking links redirect after logging the click.
SEED_TEST_TARGET_URL=

# ─────────────────────────────────────────────────────────────
# AI AGENT (/agent) — proposes and drafts; a person approves every action
# ─────────────────────────────────────────────────────────────

# Provider: "anthropic" (Claude API, paid; uses ANTHROPIC_API_KEY above) or
# "ollama" (free local model in Docker: docker compose up -d).
AGENT_PROVIDER=anthropic
# Claude model when AGENT_PROVIDER=anthropic. Defaults to claude-opus-5-5.
AGENT_MODEL=
# Ollama settings when AGENT_PROVIDER=ollama. Any model with tool calling works
# (qwen3:8b or larger is better if you have a GPU or plenty of RAM).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Max proposals per run (default 10, cap 50).
AGENT_MAX_PROPOSALS=10
# Shared secret for the n8n / cron API: Authorization: Bearer <secret>
# (POST /api/agent/run, GET /api/agent/proposals, POST /api/agent/proposals/:id)
AGENT_WEBHOOK_SECRET=
